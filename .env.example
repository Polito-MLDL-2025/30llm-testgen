OPENAI_URL_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY={key}
OPENAI_MAX_CONCURRENT_REQUESTS=4
QAAGENT_TEST_TIMEOUT_SECONDS=60.0
COVERAGE_BRANCH=true ## default: true,

# Optional shared model overrides for:
# - llm30/pipeline/QAagent/QAagent.py
# - llm30/pipeline/QAagent/QAagent_merge.py
# - llm30/pipeline/QAagent/QAagent_competitive.py
# Priority:
# 1) QAAGENT_PLAN_MODEL / QAAGENT_TEST_MODEL / QAAGENT_JUDGE_MODEL / QAAGENT_MERGE_MODEL
# 2) QAAGENT_MODEL
# 3) OPENAI_API_MODEL
# 4) CLI --model (test model only) or built-in default (plan model)
#OPENAI_API_MODEL=meta/llama3-8b-instruct
#QAAGENT_MODEL=meta/llama3-8b-instruct
#QAAGENT_PLAN_MODEL=qwen/qwen2.5-coder-32b-instruct
#QAAGENT_TEST_MODEL=meta/llama3-8b-instruct
#QAAGENT_JUDGE_MODEL=meta/llama3-8b-instruct
#QAAGENT_MERGE_MODEL=meta/llama3-8b-instruct
